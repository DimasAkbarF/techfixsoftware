# Android Service Marketplace — Environment Configuration
# Copy this file to `.env.local` and set the real values before going live.

# Public site URL used for canonical URLs, sitemap and structured data.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only (e.g. 6281234567890).
# When empty, all WhatsApp CTAs are hidden automatically.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Telegram contact URL (e.g. https://t.me/your_channel).
# When empty, all Telegram CTAs are hidden automatically.
NEXT_PUBLIC_TELEGRAM_URL=

# Support email address displayed in footer, contact and fallback CTAs.
# When empty, email links are hidden automatically.
NEXT_PUBLIC_SUPPORT_EMAIL=

# NOTE: No backend, database, or fake API is used. This project is
# a frontend-first service discovery and conversion platform (PRD V2).